<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjektGrupowy.Views.MainPage"
             Shell.NavBarIsVisible="False"
             Title="MainPage">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10"
            VerticalOptions="FillAndExpand"
            HorizontalOptions="FillAndExpand">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Left Column takes 20% of available space -->
                    <ColumnDefinition Width="200" />
                    <!-- Spacer Column (fixed space) -->
                    <ColumnDefinition Width="*" />
                    <!-- Right Column takes 80% of available space -->
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <Button x:Name="editMyDataButton"
                        Grid.Row="0" Grid.Column="0"
                        Text="Edit my data"
                        BackgroundColor="#31e8c3"
                        TextColor="Black"
                        CornerRadius="20"
                        Clicked="editMyDataButton_Clicked" />
                <Button x:Name="backButton"
                        Grid.Row="0" Grid.Column="2"
                        Text="Back"
                        BackgroundColor="#31e8c3"
                        TextColor="Black"
                        CornerRadius="20"
                        Clicked="backButton_Clicked" />
            </Grid>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button x:Name="userDetailsButton"
                        Text="My details"
                        BackgroundColor="#31e8c3"
                        TextColor="Black"
                        CornerRadius="20"
                        Clicked="userDetailsButton_Clicked" />

                <Button x:Name="logOffButton"
                        Text="Log off"
                        BackgroundColor="#ff7f7f"
                        TextColor="Black"
                        CornerRadius="20"
                        Clicked="logOffButton_Clicked" />
            </HorizontalStackLayout>

            <Label 
                x:Name="welcomeLabel"
                Text="Welcome"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="20"
                FontSize="Large"
                FontAttributes="Bold"
                TextColor="Black"
                Loaded="welcomeLabel_Loaded" />
            <ImageButton
                x:Name="startStopButton"
                Source="start_button.png"
                Aspect="AspectFit"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                HeightRequest="350"
                Clicked="startStopButton_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>